{
  "name": "fridge-recipe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "冷蔵庫にあるもので作れる献立と、ちょい足しで届く献立を提案するアプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "vitest run src/core/__tests__/data.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
